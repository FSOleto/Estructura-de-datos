#include <iostream>
using namespace std;

int main() {
    int n, a[100], x, l = 0, r; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i]; cin >> x; r = n - 1; while (l <= r) { int m = (l + r) / 2; if (a[m] == x) { cout << m << '\n'; return 0; } if (a[m] < x) l = m + 1; else r = m - 1; } cout << -1 << '\n';
    return 0;
}
