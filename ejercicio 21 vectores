// Ejercicio 21 - Intercambiar primero y último
// Leer N enteros, intercambiar el primer y último elemento.
// Entrada: N=5; 10 20 30 40 50
// Salida:  50 20 30 40 10

#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    int v[50];
    for (int i = 0; i < n; i++)
        cin >> v[i];
    int tmp = v[0];
    v[0] = v[n - 1];
    v[n - 1] = tmp;
    for (int i = 0; i < n; i++)
        cout << v[i] << " ";
    cout << endl;
    return 0;
}
