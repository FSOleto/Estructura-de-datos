#include <iostream>
using namespace std;

int main() {
    int n, a[100]; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i]; for (int i = 0; i < n - 1; ++i) for (int j = 0; j < n - 1 - i; ++j) if (a[j] > a[j + 1]) { int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; }
    if (n % 2) cout << a[n / 2]; else cout << (a[n / 2 - 1] + a[n / 2]) / 2.0; cout << '\n';
    return 0;
}
