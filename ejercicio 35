#include <iostream>
using namespace std;

int main() {
    int n, a[100], p = 0; cin >> n; 
for (int i = 0; i < n; ++i) cin >> a[i];
for (int i = 0; i < n; ++i) if (a[i] != 0) a[p++] = a[i];
while (p < n) a[p++] = 0;
    for (int i = 0; i < n; ++i) cout << a[i] << (i + 1 == n ? '\n' : ' ');
    return 0;
}
