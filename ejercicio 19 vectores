// Ejercicio 19 - Contar apariciones de un valor
// Leer 10 enteros y un valor X. Contar cuántas veces aparece X.
// Entrada: 2 4 2 7 2 9 1 2 5 2  X=2
// Salida:  Apariciones = 5

#include <iostream>
using namespace std;

int main() {
    int v[10], x, count = 0;
    for (int i = 0; i < 10; i++)
        cin >> v[i];
    cin >> x;
    for (int i = 0; i < 10; i++)
        if (v[i] == x) count++;
    cout << "Apariciones = " << count << endl;
    return 0;
}
