#include <iostream>
using namespace std;

int main() {
    int n, a[100]; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i]; for (int i = 0; i < n - 1; ++i) { int p = i; for (int j = i + 1; j < n; ++j) if (a[j] < a[p]) p = j; int t = a[i]; a[i] = a[p]; a[p] = t; }
    for (int i = 0; i < n; ++i) cout << a[i] << (i + 1 == n ? '\n' : ' ');
    return 0;
}
