// Ejercicio 11 - Duplicar cada elemento
// Leer 5 enteros, multiplicar cada elemento por 2 y mostrar el resultado.
// Entrada: 1 3 5 7 9
// Salida:  2 6 10 14 18

#include <iostream>
using namespace std;

int main() {
    int v[5];
    for (int i = 0; i < 5; i++)
        cin >> v[i];
    for (int i = 0; i < 5; i++)
        cout << v[i] * 2 << " ";
    cout << endl;
    return 0;
}
