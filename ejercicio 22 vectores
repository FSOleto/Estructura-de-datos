// Ejercicio 22 - Rotar una posición a la derecha
// El último elemento pasa a la primera posición.
// Entrada: N=5; 1 2 3 4 5
// Salida:  5 1 2 3 4

#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    int v[50];
    for (int i = 0; i < n; i++)
        cin >> v[i];
    int ultimo = v[n - 1];
    for (int i = n - 1; i > 0; i--)
        v[i] = v[i - 1];
    v[0] = ultimo;
    for (int i = 0; i < n; i++)
        cout << v[i] << " ";
    cout << endl;
    return 0;
}
