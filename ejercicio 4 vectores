// Ejercicio 4 - Calcular el promedio
// Leer 6 números reales y calcular su promedio aritmético.
// Entrada: 10 12 14 16 18 20
// Salida:  Promedio = 15

#include <iostream>
using namespace std;

int main() {
    double v[6], suma = 0;
    for (int i = 0; i < 6; i++) {
        cin >> v[i];
        suma += v[i];
    }
    cout << "Promedio = " << suma / 6 << endl;
    return 0;
}
