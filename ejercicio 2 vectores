// Ejercicio 2 - Mostrar un vector en orden inverso
// Leer 6 enteros y mostrar sus elementos desde el último hasta el primero.
// Entrada: 2 4 6 8 10 12
// Salida:  12 10 8 6 4 2

#include <iostream>
using namespace std;

int main() {
    int v[6];
    for (int i = 0; i < 6; i++)
        cin >> v[i];
    for (int i = 5; i >= 0; i--)
        cout << v[i] << " ";
    cout << endl;
    return 0;
}
