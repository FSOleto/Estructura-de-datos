#include <iostream>
using namespace std;

int main() {
    int n, a[100], mejor = 0, valor = 0; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i]; for (int i = 0; i < n; ++i) { int c = 0; for (int j = 0; j < n; ++j) if (a[i] == a[j]) ++c; if (c > mejor) { mejor = c; valor = a[i]; } } cout << valor << '\n';
    return 0;
}
