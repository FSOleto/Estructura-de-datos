// Ejercicio 23 - Rotar una posición a la izquierda
// El primer elemento pasa a la última posición.
// Entrada: N=5; 1 2 3 4 5
// Salida:  2 3 4 5 1

#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    int v[50];
    for (int i = 0; i < n; i++)
        cin >> v[i];
    int primero = v[0];
    for (int i = 0; i < n - 1; i++)
        v[i] = v[i + 1];
    v[n - 1] = primero;
    for (int i = 0; i < n; i++)
        cout << v[i] << " ";
    cout << endl;
    return 0;
}
