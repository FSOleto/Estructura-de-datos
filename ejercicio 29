#include <iostream>
using namespace std;

int main() {
    int n, a[100]; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i];
    int mayor = a[0], segundo = a[0]; bool hay = false; for (int i = 1; i < n; ++i) { if (a[i] > mayor) { segundo = mayor; mayor = a[i]; hay = true; } else if (a[i] < mayor && (!hay || a[i] > segundo)) { segundo = a[i]; hay = true; } }
    if (hay) cout << segundo; else cout << "No existe"; cout << '\n';
    return 0;
}
