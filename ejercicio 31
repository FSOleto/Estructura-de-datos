#include <iostream>
using namespace std;

int main() {
    int n, a[100]; bool usado[100] = {}; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i];
    for (int i = 0; i < n; ++i) if (!usado[i]) { int c = 0; for (int j = i; j < n; ++j) if (a[j] == a[i]) { ++c; usado[j] = true; } cout << a[i] << " -> " << c << '\n'; }
    return 0;
}
