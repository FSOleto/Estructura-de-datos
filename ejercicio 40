#include <iostream>
using namespace std;

int main() {
    int n, a[100], b[100]; bool iguales = true; cin >> n; for (int i = 0; i < n; ++i) cin >> a[i]; for (int i = 0; i < n; ++i) cin >> b[i]; for (int i = 0; i < n; ++i) if (a[i] != b[i]) iguales = false; cout << (iguales ? "Iguales" : "Diferentes") << '\n';
    return 0;
}
