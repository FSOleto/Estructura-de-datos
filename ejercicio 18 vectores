// Ejercicio 18 - Obtener la primera posición de un valor
// Leer 10 enteros y un valor X. Mostrar el primer índice donde aparece; si no existe, -1.
// Entrada: 5 8 3 8 2 9 8 1 4 6  X=8
// Salida:  Primera posición = 1

#include <iostream>
using namespace std;

int main() {
    int v[10], x, pos = -1;
    for (int i = 0; i < 10; i++)
        cin >> v[i];
    cin >> x;
    for (int i = 0; i < 10; i++)
        if (v[i] == x) { pos = i; break; }
    cout << "Primera posicion = " << pos << endl;
    return 0;
}
